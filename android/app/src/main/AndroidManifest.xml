<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Granted over ADB (pm grant): Rearm switches accessibility off and on to wake the Apple TV app. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- No launcher activity: the app only runs as an accessibility service. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <service
            android:name=".BadgeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/badge_service" />
        </service>

        <receiver android:name=".Rearm" android:exported="false" />
    </application>
</manifest>
